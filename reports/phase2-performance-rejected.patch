diff --git a/tests/contact-geometry.test.ts b/tests/contact-geometry.test.ts
new file mode 100644
index 0000000..0cab8ba
--- /dev/null
+++ b/tests/contact-geometry.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, it } from 'vitest';
+import { contactNormalsAt, penetration, projectMotion, sweepBox, type Solid } from '../shared/contact-geometry';
+
+const solid = (): Solid => ({ id: 0, minX: -2, maxX: 2, minY: -2, maxY: 0, minZ: -2, maxZ: 2 });
+const half = () => ({ x: .25, y: .45, z: .25 });
+
+describe('cached contact geometry', () => {
+  it('invalidates every changed terrain boundary and half extent', () => {
+    const box = solid(), size = half();
+    const probes = () => {
+      for (const x of [-2.25, 0, 2.25]) for (const y of [-2.45, 0, .45]) for (const z of [-2.25, 0, 2.25]) {
+        const p = { x, y, z }, to = { x: -x, y: y - 1, z: -z };
+        // Fresh object identities force recomputation for the reference call.
+        expect(penetration(p, size, box)).toStrictEqual(penetration(p, { ...size }, { ...box }));
+        expect(sweepBox(p, to, size, box)).toStrictEqual(sweepBox(p, to, { ...size }, { ...box }));
+        expect(contactNormalsAt(p, size, [box])).toStrictEqual(contactNormalsAt(p, { ...size }, [{ ...box }]));
+        expect(projectMotion(p, to, size, [box])).toStrictEqual(projectMotion(p, to, { ...size }, [{ ...box }]));
+      }
+    };
+    probes();
+    for (const key of ['minX', 'maxX', 'minY', 'maxY', 'minZ', 'maxZ'] as const) { box[key] += .5; probes(); }
+    for (const key of ['x', 'y', 'z'] as const) { size[key] += .5; probes(); }
+  });
+  it('clears reused normal output while keeping default results independent', () => {
+    const box = solid(), size = half(), p = { x: 0, y: size.y, z: 0 };
+    const first = contactNormalsAt(p, size, [box]);
+    const output = [{ x: 99, y: 99, z: 99 }];
+    expect(contactNormalsAt(p, size, [box], output)).toBe(output);
+    expect(output).toStrictEqual(first);
+    contactNormalsAt({ ...p, y: 10 }, size, [box], output);
+    expect(output).toStrictEqual([]); expect(first).toStrictEqual([{ x: 0, y: 1, z: 0 }]);
+  });
+});

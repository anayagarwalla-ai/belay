@@ -0,0 +1,53 @@
+import { beforeAll, describe, expect, it } from 'vitest';
+import { TUNING, FAMILIES } from '../tuning';
+import { initializePhysics } from '../shared/simulation';
+import { envelope, fixtureFor, heldIds, matrixSpecs, recutInputs, runRecut, screenSpecs, type Spec } from '../scripts/rescue-recut-harness';
+import { ExpeditionSimulation } from '../shared/expedition-simulation';
+
+beforeAll(initializePhysics);
+const spec: Spec = { variant: 'wall-450', n: 2, casualty: 1, bank: 'same', surface: 'snow', policy: 'static-helpers' };
+
+describe('bounded re-cut evidence', () => {
+  it('keeps a near-bank helper hauling away while its body partly overhangs the lip', () => {
+    const simulation = new ExpeditionSimulation({ scene: 'rescue', playerCount: spec.n }, fixtureFor(spec));
+    try {
+      const state = simulation.snapshot(); state.tick = state.tickHz;
+      state.players[0].position.z = TUNING.body.depth / 4;
+      expect(recutInputs({ ...spec, policy: 'pull-away' }, state)[0].z).toBe(-1);
+    } finally { simulation.dispose(); }
+  });
+  it('covers all helper freeze interventions without initial stretched rope or empty hold claims', () => {
+    for (const row of [...screenSpecs(), ...matrixSpecs()]) {
+      const fixture = fixtureFor(row);
+      expect(fixture.positions).toHaveLength(row.n);
+      for (let id = 1; id < row.n; id++) {
+        const a = fixture.positions[id - 1], b = fixture.positions[id];
+        expect(Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z)).toBeLessThanOrEqual(FAMILIES.balanced.ropeLength);
+      }
+      if (row.policy.startsWith('frozen')) expect(heldIds(row).length).toBeGreaterThan(0);
+    }
+    for (const n of TUNING.rescueRecut.teamSizes) for (let id = 0; id < n; id++) if (id !== Math.floor(n / 2)) {
+      expect(matrixSpecs().some(row => row.n === n && row.policy === 'frozen-helper' && row.frozenId === id && row.frozenBrace === false)).toBe(true);
+      expect(matrixSpecs().some(row => row.n === n && row.policy === 'frozen-helper' && row.frozenId === id && row.frozenBrace === true)).toBe(true);
+    }
+  });
+  it('retains the actual baseline static-brace rescue as a verified counterexample', () => {
+    const row = runRecut({ ...spec, variant: 'baseline' });
+    expect(row.ending).toBe('recovered');
+    expect(row.heldIds).toEqual([0]);
+    expect(row.heldPolicyVerified).toBe(true);
+    expect(row.passiveRecoveryCounterexample).toBe(true);
+  });
+  it('reconstructs actual motor work and enforces the subweight wall effort without claiming impossibility', () => {
+    const priorEffort = TUNING.phase2.wallNormalEffortN;
+    const row = runRecut(spec);
+    expect(row.error).toBeNull();
+    expect(row.ending).toBe('censored');
+    expect(row.roles[1].maximumWallEffortN).toBe(envelope(TUNING.rescueRecut.variants[1], 'snow').wallCapacityN);
+    expect(Math.abs(row.motorWorkReconstructionErrorJ)).toBeLessThan(TUNING.phase2.energyToleranceJ);
+    expect(row.heldPolicyVerified).toBe(true);
+    expect(row.diagnostics.maximumTerrainPenetrationM).toBeLessThan(TUNING.physicsDiagnostics.maximumFloorErrorM);
+    expect(row.counters.maximumSegmentErrorM).toBeLessThan(TUNING.physicsDiagnostics.maximumSegmentErrorM);
+    expect(TUNING.phase2.wallNormalEffortN).toBe(priorEffort);
+  });
+});

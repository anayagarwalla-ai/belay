@@ -0,0 +1,44 @@
+import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { initializePhysics } from '../shared/simulation';
+import { TUNING } from '../tuning';
+import { runRecut, screenSpecs, matrixSpecs } from './rescue-recut-harness';
+
+const mode = process.argv[2] ?? 'screen';
+if (!['screen', 'matrix'].includes(mode)) throw new Error('Use screen or matrix.');
+const worker = process.argv[3] === undefined ? null : Number(process.argv[3]);
+if (worker !== null && (mode !== 'matrix' || !Number.isInteger(worker) || worker < 0 || worker >= TUNING.rescueRecut.maximumWorkers)) throw new Error('Invalid bounded worker.');
+await initializePhysics();
+const specs = (mode === 'screen' ? screenSpecs() : matrixSpecs()).filter((_, id) => worker === null || id % TUNING.rescueRecut.maximumWorkers === worker);
+const rows = [];
+mkdirSync('reports', { recursive: true });
+const output = `${mode}${worker === null ? '' : `-worker-${worker}`}`;
+const prefix = 'reports/rescue-recut-matrix-prefix.jsonl';
+const cached = new Map(worker !== null && existsSync(prefix) ? readFileSync(prefix, 'utf8').trim().split('\n').filter(Boolean).map(line => {
+  const row = JSON.parse(line) as ReturnType<typeof runRecut>; return [JSON.stringify(row.spec), row];
+}) : []);
+const checkpoint = `reports/rescue-recut-${output}.jsonl`;
+writeFileSync(checkpoint, '');
+let checkpointBytes = 0, reusedRows = 0;
+for (const [i, spec] of specs.entries()) {
+  const saved = cached.get(JSON.stringify(spec));
+  if (saved) reusedRows++;
+  const row = saved ?? runRecut(spec); rows.push(row);
+  const raw = `${JSON.stringify(row)}\n`; checkpointBytes += Buffer.byteLength(raw);
+  if (checkpointBytes > TUNING.rescueRecut.reportMaximumBytes) throw new Error('Checkpoint exceeds root byte bound.');
+  appendFileSync(checkpoint, raw);
+  console.log(JSON.stringify({ i: i + 1, total: specs.length, ...spec, ending: row.ending, rescueSeconds: row.rescueSeconds,
+    finalY: row.finalPlayers[spec.casualty].position.y, counterexample: row.passiveRecoveryCounterexample,
+    penetrationM: row.diagnostics.maximumTerrainPenetrationM, segmentErrorM: row.counters.maximumSegmentErrorM }));
+}
+const report = { generatedAt: new Date().toISOString(), mode, worker, reusedRows, baselineSha: TUNING.rescueRecut.baselineSha,
+  tuningSha256: createHash('sha256').update(JSON.stringify(TUNING)).digest('hex'), tuning: TUNING,
+  limitations: ['Scripted mechanics only; no human or remote-feel evidence.',
+    'Tension is the baseline correction-derived scalar estimate; residual force includes solver and energy projection.',
+    'Snow and ice change ground traction only; wall friction is the same prescribed wall material.',
+    'Censored policies do not prove physical impossibility; any verified passive recovery is a constructive counterexample.'], rows };
+const json = JSON.stringify(report, null, 2);
+if (Buffer.byteLength(json) > TUNING.rescueRecut.reportMaximumBytes) throw new Error('Report exceeds root byte bound.');
+mkdirSync('reports', { recursive: true });
+writeFileSync(`reports/rescue-recut-${output}.json`, `${json}\n`);
+console.log(JSON.stringify({ saved: `reports/rescue-recut-${output}.json`, rows: rows.length, bytes: Buffer.byteLength(json) }));

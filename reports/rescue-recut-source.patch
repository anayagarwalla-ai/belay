@@ -0,0 +1,146 @@
+import { readFileSync, writeFileSync } from 'node:fs';
+import { TUNING } from '../tuning';
+import type { runRecut } from './rescue-recut-harness';
+
+type Row = ReturnType<typeof runRecut>;
+type Report = { rows: Row[] };
+const screen = JSON.parse(readFileSync('reports/rescue-recut-screen.json', 'utf8')) as Report;
+const matrix = JSON.parse(readFileSync('reports/rescue-recut-matrix.json', 'utf8')) as Report;
+const n = (value: number, digits = 3) => value.toFixed(digits);
+const bounds = (row: Row) => row.error === null
+  && [row.diagnostics.maximumTerrainPenetrationM, row.diagnostics.maximumBodyOverlapM,
+    row.counters.maximumSpanErrorM, row.counters.maximumSegmentErrorM].every(Number.isFinite)
+  && row.diagnostics.maximumTerrainPenetrationM <= TUNING.physicsDiagnostics.maximumFloorErrorM
+  && row.diagnostics.maximumBodyOverlapM <= TUNING.physicsDiagnostics.maximumBodyOverlapM
+  && row.counters.maximumSpanErrorM <= TUNING.physicsDiagnostics.maximumSpanErrorM
+  && row.counters.maximumSegmentErrorM <= TUNING.physicsDiagnostics.maximumSegmentErrorM;
+const success = (rows: Row[]) => `${rows.filter(r => r.ending === 'recovered').length}/${rows.length}`;
+const range = (values: number[]) => values.length ? `${n(Math.min(...values))}–${n(Math.max(...values))}` : '—';
+const topology = (row: Row) => {
+  const banks = new Set(row.initialPositions.filter((_, id) => id !== row.spec.casualty).map(p => p.z < TUNING.phase2.rescueLipZ ? 'near' : 'far'));
+  return banks.size > 1 ? 'helpers on both banks' : `helpers on the ${[...banks][0]} bank`;
+};
+const screenRows = TUNING.rescueRecut.variants.flatMap(v => TUNING.rescueRecut.screenTeams.map(team => {
+  const rows = screen.rows.filter(r => r.spec.variant === v.name && r.spec.n === team);
+  return `| ${v.name} | ${team} | ${rows.map(r => r.ending === 'recovered' ? n(r.rescueSeconds!) : 'censored').join(' | ')} | ${rows.filter(bounds).length}/${rows.length} |`;
+}));
+const matrixRows = TUNING.rescueRecut.teamSizes.flatMap(team => (['snow', 'ice'] as const).map(surface => {
+  const rows = matrix.rows.filter(r => r.spec.n === team && r.spec.surface === surface && r.spec.bank === 'same' && r.spec.casualty === Math.floor(team / 2));
+  const policy = (name: string) => rows.filter(r => r.spec.policy === name);
+  const frozen = rows.filter(r => r.spec.policy.startsWith('frozen'));
+  return `| ${team} | ${surface} | ${success(policy('pull-away').concat(policy('fan-out')))} | ${success(policy('static-helpers'))} | ${success(policy('idle-casualty'))} | ${success(frozen)} | ${frozen.filter(r => r.passiveRecoveryCounterexample && bounds(r)).length} |`;
+}));
+const geometricFailures = [...screen.rows, ...matrix.rows].filter(r => !bounds(r));
+const counterexamples = matrix.rows.filter(r => r.passiveRecoveryCounterexample && bounds(r));
+const exemplars = TUNING.rescueRecut.teamSizes.map(team => counterexamples.find(r => r.spec.n === team && r.spec.surface === 'snow' && r.spec.frozenBrace)).filter((row): row is Row => !!row);
+const rotatedRows = TUNING.rescueRecut.teamSizes.flatMap(team => (['same', 'split'] as const).map(bank => {
+  const rows = matrix.rows.filter(r => r.spec.n === team && r.spec.bank === bank);
+  return `| ${team} | ${bank === 'split' ? 'centered' : 'near-lip'} | ${success(rows.filter(r => ['pull-away', 'fan-out'].includes(r.spec.policy)))} | ${success(rows.filter(r => r.spec.policy === 'static-helpers'))} | ${success(rows.filter(r => r.spec.policy === 'idle-casualty'))} |`;
+}));
+const all = [...screen.rows, ...matrix.rows], selected = matrix.rows;
+const max = (f: (row: Row) => number) => Math.max(...selected.map(f));
+const text = `# Rescue re-cut mechanical evidence
+
+Baseline: \`${TUNING.rescueRecut.baselineSha}\`. Commands: \`npx tsx scripts/rescue-recut-run.ts screen\`, \`npx tsx scripts/rescue-recut-run.ts matrix\`, then \`npx tsx scripts/rescue-recut-summary.ts\`.
+
+**Phase 2 still fails the static-role requirement; Phase 3 remains blocked.** Subweight wall assistance removes the original all-static-helper example in the observed window, while passive helper recoveries remain. Human feel and agency are unmeasured. These are deterministic policy outcomes, not first-attempt human recovery percentages.
+
+## Fixed screen: 32 trajectories
+
+Recovery duration is first fall to confirmed team recovery, in simulation seconds. Censored means no recovery during ${TUNING.rescueRecut.horizonSeconds} seconds from fixture start. Each row contains one trial per policy; no confidence/population inference applies. Contact/rope bounds use the existing 1 mm terrain, 5 mm body, 1 cm span and 2 cm segment ceilings. Energy is reported separately, not certified by that column.
+
+| Variant | Bodies | Pull away | Fan out | Static helpers | Idle casualty | Contact/rope bounds |
+|---|---:|---:|---:|---:|---:|---:|
+${screenRows.join('\n')}
+
+The stance variant is rejected: successful recovery with an excessive rope residual is not a qualified success. Neither its failed straight haul nor its contact-error cases are removed from the report. The wall-450 matrix was selected analytically before outcomes; no additional tuning was performed after this screen.
+
+## Fixed wall-450 role matrix: ${matrix.rows.length} trajectories
+
+Canonical same-bank middle casualty. Counts are observed recoveries/trials; frozen interventions include REST and continuous brace, each helper separately and all remote helpers together where such helpers exist. The final column counts passive recoveries that also meet the contact/rope bounds.
+
+| Bodies | Surface | Active policies | All helpers static | Idle casualty | Frozen interventions | Passive recoveries within bounds |
+|---|---|---:|---:|---:|---:|---:|
+${matrixRows.join('\n')}
+
+Head/middle/tail placement coverage, combining snow and ice (near-lip includes the canonical matrix above). The raw spec's \`bank: 'split'\` names the centered-casualty fixture family: only interior casualties have helpers on both banks. Endpoint casualties in that family have helpers on one bank and start at the hole center; they are not evidence for a split-bank endpoint rescue. Every row retains exact initial positions.
+
+| Bodies | Placement family | Active policies | All helpers static | Idle casualty |
+|---|---|---:|---:|---:|
+${rotatedRows.join('\n')}
+
+## Constructive static-role counterexamples
+
+${exemplars.map(row => `- Matrix row ${matrix.rows.indexOf(row) + 1}: ${row.spec.n} bodies, ${topology(row)}, ${row.spec.surface}, casualty P${row.spec.casualty + 1}; P${row.heldIds.map(id => id + 1).join('/P')} continuously braces from tick 0 through confirmed recovery (${n(row.rescueSeconds!)} s). Held-input verification: ${row.heldPolicyVerified}. Accepted-input SHA-256: \`${row.acceptedInputsSha256}\`.`).join('\n')}
+
+All remote helpers held together:
+
+${counterexamples.filter(row => row.spec.policy === 'frozen-remote' && row.spec.frozenBrace && row.spec.surface === 'snow').map(row => `- Matrix row ${matrix.rows.indexOf(row) + 1}: ${row.spec.n} bodies, casualty P${row.spec.casualty + 1}; remote P${row.heldIds.map(id => id + 1).join('/P')} continuously brace from tick 0; recovery ${n(row.rescueSeconds!)} s, maximum segment residual ${n(row.counters.maximumSegmentErrorM, 6)} m.`).join('\n') || 'None observed within contact/rope bounds.'}
+
+Idle-casualty recoveries within contact/rope bounds:
+
+${counterexamples.filter(row => row.spec.policy === 'idle-casualty').map(row => `- Matrix row ${matrix.rows.indexOf(row) + 1}: ${row.spec.n} bodies, ${topology(row)}, ${row.spec.surface}, casualty P${row.spec.casualty + 1} starts at z=${n(row.initialPositions[row.spec.casualty].z)} m and holds exact REST from tick 0; recovery ${n(row.rescueSeconds!)} s. Accepted-input SHA-256: \`${row.acceptedInputsSha256}\`.`).join('\n') || 'None observed in these policies.'}
+
+There are ${counterexamples.length} observed passive recoveries within contact/rope bounds across the full matrix. A frozen player's body may move under rope load; that is not an action change by the player. Loaded-time and motion are observational proxies, not proof of useful voluntary action. Freezing inputs leaves the body on the rope: it tests whether voluntary action changes are necessary, not whether that body’s mass or static support is necessary. No role gate masks these outcomes.
+
+## Actual force, motion and numerical limits
+
+Wall-450 uses a 585 N vertical wall-motor cap versus 784.8 N weight, leaving a minimum 199.8 N upward rope resultant for steady ascent. Wall-300 leaves 394.8 N. An idle casualty needs approximately the full 784.8 N from the rope. These are motor/geometry bounds in the current model, not calibrated human force measurements. Ground effort limits are 800 N on snow and 240 N on ice; nominal brace budgets are 1255.68 N and 376.704 N before consumed braking effort. The ice fixtures change ground traction, not wall material.
+
+For the wall-450 matrix:
+
+- Recovered rescue duration: ${range(selected.flatMap(r => r.rescueSeconds === null ? [] : [r.rescueSeconds]))} s; ${selected.filter(r => r.rescueSeconds !== null && r.rescueSeconds >= TUNING.phase2Evidence.targets.rescueSeconds[0] && r.rescueSeconds <= TUNING.phase2Evidence.targets.rescueSeconds[1]).length}/${selected.filter(r => r.rescueSeconds !== null).length} recovered scripted trials land in the 10–20 s target. Human normal-rescue timing remains unmeasured.
+- Observed wall vertical motor maximum: ${n(max(r => Math.max(...r.roles.map(p => p.maximumWallEffortN))))} N. Motor-work reconstruction error maximum: ${max(r => Math.abs(r.motorWorkReconstructionErrorJ)).toExponential(3)} J.
+- Correction-derived scalar tension maximum: ${n(max(r => r.maximumTensionN))} N; this is not a calibrated force sensor or the upward component. Sampled endpoint tangents use the routed particle path, never the straight harness chord.
+- Maximum instantaneous horizontal motor force: ${n(max(r => Math.max(...r.roles.map(p => p.maximumMotorHorizontalForceN))))} N. The baseline wall press/lateral velocity assignment can exceed the nominal wall normal-effort parameter. That parameter bounds vertical tangential effort; it does not equal measured contact normal force. This limits any claim of Coulomb-consistent wall traction.
+- Maximum net residual vertical force magnitude: ${n(max(r => Math.max(...r.roles.map(p => p.maximumResidualVerticalForceN))))} N. Residual = observed momentum change minus gravity and reconstructed motor; it includes Rapier contacts, rope/contact projection and kinetic-energy correction, so it is not separately attributable tension.
+- Maximum single-step kinetic-energy projection: ${n(max(r => r.diagnostics.maximumEnergyProjectionJ))} J; maximum unresolved potential-energy excess: ${n(max(r => r.diagnostics.maximumPotentialExcessJ))} J; pre-projection unexplained-energy diagnostic: ${n(max(r => r.diagnostics.maximumUnexplainedEnergyGainJ))} J. No energy-conservation proof is claimed.
+- Maximum terrain penetration: ${n(max(r => r.diagnostics.maximumTerrainPenetrationM), 6)} m; body overlap: ${n(max(r => r.diagnostics.maximumBodyOverlapM), 6)} m; span residual: ${n(max(r => r.counters.maximumSpanErrorM), 6)} m; segment residual: ${n(max(r => r.counters.maximumSegmentErrorM), 6)} m.
+- The retained \`solverIterations\` diagnostic is the last substep count, not the lifetime maximum; do not use it to claim that an earlier residual converged.
+
+${geometricFailures.length}/${all.length} trajectories across screen plus matrix exceed an existing contact/rope ceiling or report an error. Exact failures:
+
+${geometricFailures.map(row => `- ${screen.rows.includes(row) ? 'Screen' : 'Matrix'} row ${(screen.rows.includes(row) ? screen.rows : matrix.rows).indexOf(row) + 1}: \`${JSON.stringify(row.spec)}\`; ending ${row.ending}, segment ${n(row.counters.maximumSegmentErrorM, 6)} m, span ${n(row.counters.maximumSpanErrorM, 6)} m, overlap ${n(row.diagnostics.maximumBodyOverlapM, 6)} m, penetration ${n(row.diagnostics.maximumTerrainPenetrationM, 6)} m${row.error ? `; error ${row.error}` : ''}.`).join('\n')}
+
+## Exit geometry and limp-body conflict
+
+The sampled rope tangents, final body locations and wall/ground occupancy retain rim stalls explicitly. Censored idle-casualty rescues mean these particular policies did not clear the body, not that limp-body recovery is impossible. At the rim the routed rope's upward component can shrink while the box still needs vertical clearance. Changing the helpers' initial stance alone did not reliably solve this and sometimes exceeded rope tolerances.
+
+A disconnected limp body is not an active participant and should not itself be scored as a connected player’s functional inactivity. Its recoverability nevertheless implies recoverability of an identical physical state with zero input from a connected casualty. The idle-casualty examples make that possibility concrete: casualty action changes are not mechanically necessary in those fixtures. Useful opportunities to participate are a separate criterion. Similarly, adjacent haulers can perform enough work while remote helpers remain static or slack. Reduced wall effort improves the self-climbing envelope; it does not pass the every-role requirement.
+
+Raw sources: [screen JSON](rescue-recut-screen.json), [matrix JSON](rescue-recut-matrix.json), and [preregistered design note](../docs/design/phase2-recut-experiments.md). Each row retains fixture geometry, exact input digest, outcomes/events, per-role motion/contact/motor aggregates, full solver/energy diagnostics and one-second sampled rope/body state. Full root tuning and source baseline are exported. No human sessions, remote trials, art, deployment or Phase 3 work occurred.
+`;
+writeFileSync('reports/rescue-recut-summary.md', text);
+console.log(JSON.stringify({ trajectories: all.length, passiveWithinContactBounds: counterexamples.length, geometricFailures: geometricFailures.length }));
+
+const staticExample = counterexamples.find(r => r.spec.n === 3 && r.spec.policy === 'frozen-helper' && r.spec.frozenBrace);
+const idleExample = counterexamples.find(r => r.spec.n === 4 && r.spec.policy === 'idle-casualty' && r.spec.bank === 'split');
+const example = (row: Row | undefined, description: string) => row ? `${description}: matrix row ${matrix.rows.indexOf(row) + 1}, ${n(row.rescueSeconds!)} s; held inputs verified, maximum segment residual ${n(row.counters.maximumSegmentErrorM, 6)} m.` : `${description}: no qualified example recorded.`;
+const decision = `# Re-cut decision: keep experimental, do not select as a Phase 2 solution
+
+Core candidate: \`54eec098d3e90abf5cd9c3b59a5927c0c3c48c89\` on \`codex/phase2-rescue-recut\`. The candidate changes wall effort/version and mechanics regressions only. Experiment hooks and evidence are separate commits. No Phase 3 work or human gate pass is implied.
+
+**The 450 N variant improves the force envelope but still fails the static-role requirement and is not a validated 2–6-player solution.** It caps vertical wall assistance at 585 N against 784.8 N weight, requiring at least 199.8 N upward rope force for steady ascent. The original 1170 N cap allowed self-climbing.
+
+The final dataset is complete: 32 screen cases plus 250 matrix cases. Separate preflight evidence retains a 32-case screen and 60 interrupted-matrix outcome rows; these are not pooled into final counts. There was one documented helper-policy bug correction, not another parameter family.
+
+| Variant | Decision |
+|---|---|
+| Baseline, 900 N | Original static-helper self-climb remains an explicit failure. |
+| 450 N | Original two-player all-static-helper climb censored at 30 s; active snow rescues remain possible. Other static helpers and idle casualties can still recover. |
+| 300 N | Reject as a selected variant: the two-player fan-out policy stalls and exceeds the 2 cm segment ceiling. |
+| 450 N, wider/nearer stance | Reject: some stalls remain; maximum screen segment residual is 0.109 m. |
+
+${example(staticExample, 'Static helper: three players, middle casualty P2, P3 continuously braces from tick zero')}
+
+${example(idleExample, 'Idle casualty: four players, tail P4 starts at z=1.4 m, all helpers on the near bank; P4 holds REST throughout')}
+
+Across the matrix, ${counterexamples.length} passive recoveries meet existing contact/rope bounds; ${selected.filter(r => !bounds(r)).length}/250 cases exceed a contact/rope ceiling or error. Recovered duration spans ${range(selected.flatMap(r => r.rescueSeconds === null ? [] : [r.rescueSeconds]))} s. The 10–20 s rescue target and human participation/feel remain unvalidated. This focused fixture work does not establish incident count, route duration, first-exposure probabilities or four-incident completion.
+
+Numerical limits are material: maximum single-step kinetic-energy removal ${n(max(r => r.diagnostics.maximumEnergyProjectionJ))} J; unresolved potential excess ${n(max(r => r.diagnostics.maximumPotentialExcessJ))} J. Wall horizontal motor assignments can reach ${n(max(r => Math.max(...r.roles.map(p => p.maximumMotorHorizontalForceN))))} N, so the nominal normal-effort parameter is not a measured Coulomb contact normal. The solver was retained, not tuned to hide these failures.
+
+A disconnected limp body is not an active participant, so its recovery alone is not an agency verdict. But an identically idle connected casualty can share the same physics. The zero-input recovery above shows that casualty action changes are not mechanically necessary in that fixture. Available useful participation is a different criterion from mechanically necessary action. Freezing a helper leaves its body and static support present; it does not prove the body is unnecessary. No connection/input gate is proposed.
+
+[Detailed results and exact failure rows](rescue-recut-summary.md) · [Raw screen](rescue-recut-screen.json) · [Raw matrix](rescue-recut-matrix.json) · [Derivation and protocol](../docs/design/phase2-recut-experiments.md)
+`;
+writeFileSync('reports/rescue-recut-decision.md', decision);

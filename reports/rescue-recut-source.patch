index 0000000..91863f0
--- /dev/null
+++ b/scripts/rescue-recut-harness.ts
@@ -0,0 +1,206 @@
+import { createHash } from 'node:crypto';
+import { TUNING, FAMILIES } from '../tuning';
+import { ExpeditionSimulation, type RescueRecutFixture } from '../shared/expedition-simulation';
+import { physicalTerrain } from '../shared/terrain';
+import { supportAt } from '../shared/contact-geometry';
+import { motorVelocity } from '../shared/movement';
+import { REST, normalizeMove, type Move, type Vec3, type SimulationSnapshot } from '../shared/protocol';
+
+export type Variant = typeof TUNING.rescueRecut.variants[number];
+export type Policy = 'pull-away' | 'fan-out' | 'static-helpers' | 'idle-casualty' | 'frozen-helper' | 'frozen-remote';
+export type Spec = { variant: Variant['name']; n: number; casualty: number; bank: 'same' | 'split'; surface: 'snow' | 'ice';
+  policy: Policy; frozenId?: number; frozenBrace?: boolean };
+const profile = TUNING.rescueRecut;
+const half = { x: TUNING.body.width / 2, y: TUNING.body.height / 2, z: TUNING.body.depth / 2 };
+const distance = (a: Vec3, b: Vec3) => Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);
+const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
+const dot = (a: Vec3, b: Vec3) => a.x * b.x + a.y * b.y + a.z * b.z;
+const hold = (): Move => ({ ...REST, brace: true });
+const variantFor = (name: Variant['name']) => profile.variants.find(v => v.name === name)!;
+
+export function envelope(variant: Variant, surface: Spec['surface']) {
+  const weightN = TUNING.body.mass * TUNING.gravity;
+  const scale = surface === 'ice' ? TUNING.phase2.iceTractionMultiplier : 1;
+  const wallCapacityN = variant.wallNormalEffortN * TUNING.phase2.wallFriction;
+  return { weightN, wallCapacityN, wallBodyWeights: wallCapacityN / weightN,
+    requiredUpwardRopeN: Math.max(0, weightN - wallCapacityN), idleCasualtyRequiredUpwardRopeN: weightN,
+    snowOrIceGroundMotorLimitN: TUNING.body.mass * TUNING.body.acceleration * scale,
+    nominalBraceTractionN: FAMILIES.balanced.braceFriction * weightN * scale,
+    angularRopeDemandN: [Math.PI / 2, Math.PI / 4, Math.PI / 6].map(angle => ({ angleRadians: angle,
+      minimumTensionN: Math.max(0, weightN - wallCapacityN) / Math.sin(angle) })) };
+}
+
+export function fixtureFor(spec: Spec): RescueRecutFixture {
+  const variant = variantFor(spec.variant);
+  const spacing = spec.bank === 'split' ? profile.splitSpacingM : variant.spacingM;
+  const positions = Array.from({ length: spec.n }, (_, id) => ({ x: (id - (spec.n - 1) / 2) * spacing,
+    y: half.y + TUNING.phase2.collisionSkin,
+    z: id === spec.casualty ? (spec.bank === 'split' ? TUNING.phase2.crevasseWidth / 2 : TUNING.phase2.rescueFallerAdvance)
+      : spec.bank === 'split' && id > spec.casualty ? TUNING.phase2.crevasseWidth + variant.safeOffsetM : -variant.safeOffsetM }));
+  const state = physicalTerrain('rescue', TUNING.seed).state;
+  return { positions, ice: spec.surface === 'ice' ? [state.bounds] : [] };
+}
+
+export function heldIds(spec: Spec) {
+  if (spec.policy === 'static-helpers') return Array.from({ length: spec.n }, (_, id) => id).filter(id => id !== spec.casualty);
+  if (spec.policy === 'frozen-helper') return [spec.frozenId!];
+  if (spec.policy === 'frozen-remote') return Array.from({ length: spec.n }, (_, id) => id).filter(id => Math.abs(id - spec.casualty) > 1);
+  if (spec.policy === 'idle-casualty') return [spec.casualty];
+  return [];
+}
+
+export function recutInputs(spec: Spec, snapshot: SimulationSnapshot): Move[] {
+  const held = heldIds(spec);
+  const gap = snapshot.terrain.crevasses[0];
+  const casualty = snapshot.players[spec.casualty];
+  // In split-bank scenes a head casualty follows its existing rope toward the far bank.
+  // Interior/tail casualties choose the near bank. Selection stays fixed at the corner.
+  const exitZ = spec.bank === 'split' && spec.casualty === 0 ? gap.maxZ : gap.minZ;
+  return snapshot.players.map(player => {
+    if (held.includes(player.id)) return { ...REST, brace: spec.policy === 'static-helpers' || !!spec.frozenBrace };
+    if (player.id === spec.casualty || player.support !== 'ground') {
+      if (player.support === 'ground' && snapshot.incidents.some(i => i.playerIds.includes(player.id))) return hold();
+      return { x: 0, z: exitZ === gap.minZ ? -1 : 1, brace: false };
+    }
+    if (snapshot.tick / snapshot.tickHz < profile.catchSeconds) return hold();
+    // Away from the local bank's visible lip. There is no force/tension threshold in the policy.
+    const awayZ = player.position.z < (gap.minZ + gap.maxZ) / 2 ? -1 : 1;
+    return normalizeMove({ x: spec.policy === 'fan-out' ? Math.sign(player.position.x - casualty.position.x) : 0,
+      z: awayZ, brace: false });
+  });
+}
+
+/** Reconstruct the exact pre-Rapier motor from the public initial substep state.
+ * Running at physicsHz makes this one-to-one with the engine, including contact loss.
+ * Residual force includes contacts, rope, Rapier friction and energy projection; it is
+ * explicitly not labelled tension or a calibrated contact force. */
+function motorAt(position: Vec3, velocity: Vec3, input: Move, solids: ReturnType<typeof physicalTerrain>['solids'], fixture: RescueRecutFixture) {
+  const contact = supportAt(position, half, solids), dt = 1 / TUNING.physicsHz;
+  let v = { ...velocity }, wallY = 0;
+  if (contact.support === 'ground') {
+    const ice = fixture.ice.some(p => position.x >= p.minX && position.x <= p.maxX && position.z >= p.minZ && position.z <= p.maxZ);
+    v = motorVelocity(v, input, dt * (ice ? TUNING.phase2.iceTractionMultiplier : 1), 'balanced');
+  } else if (contact.support === 'wall') {
+    const toward = -(input.x * contact.normal.x + input.z * contact.normal.z);
+    if (input.brace || toward || input.x || input.z) {
+      const p = TUNING.phase2;
+      const targetY = input.brace ? 0 : toward * (toward > 0 ? p.wallClimbSpeed : p.wallDescendSpeed);
+      wallY = clamp(TUNING.body.mass * clamp((targetY - v.y) / dt, -p.wallAcceleration, p.wallAcceleration)
+        + TUNING.body.mass * TUNING.gravity, -p.wallFriction * p.wallNormalEffortN, p.wallFriction * p.wallNormalEffortN);
+      v.y += wallY / TUNING.body.mass * dt;
+      const press = toward > 0 || input.brace ? -p.wallPressSpeed : Math.max(0, -toward) * p.wallPressSpeed;
+      v.x = (input.brace ? 0 : (input.x + toward * contact.normal.x) * p.wallClimbSpeed) + press * contact.normal.x;
+      v.z = (input.brace ? 0 : (input.z + toward * contact.normal.z) * p.wallClimbSpeed) + press * contact.normal.z;
+    }
+  }
+  return { contact: contact.support, wallY, force: { x: (v.x - velocity.x) * TUNING.body.mass / dt,
+    y: (v.y - velocity.y) * TUNING.body.mass / dt, z: (v.z - velocity.z) * TUNING.body.mass / dt },
+    workJ: TUNING.body.mass / 2 * (dot(v, v) - dot(velocity, velocity)) };
+}
+
+export function runRecut(spec: Spec) {
+  const variant = variantFor(spec.variant), fixture = fixtureFor(spec), dt = 1 / TUNING.physicsHz;
+  // Sequential offline runs only; always restored, including exceptions. No per-team force multiplier.
+  const mutable = TUNING.phase2 as unknown as { wallNormalEffortN: number };
+  const savedEffort = mutable.wallNormalEffortN;
+  mutable.wallNormalEffortN = variant.wallNormalEffortN;
+  const initialSpanChordsM = fixture.positions.slice(1).map((p, id) => distance(p, fixture.positions[id]));
+  if (initialSpanChordsM.some(length => length > FAMILIES.balanced.ropeLength)) {
+    mutable.wallNormalEffortN = savedEffort;
+    throw new Error(`Initial rope length violated: ${JSON.stringify(spec)}`);
+  }
+  const sim = new ExpeditionSimulation({ scene: 'rescue', playerCount: spec.n, tickHz: TUNING.physicsHz as 60 }, fixture);
+  const solids = physicalTerrain('rescue', TUNING.seed).solids;
+  const roles = fixture.positions.map(() => ({ distanceM: 0, loadedSeconds: 0, inputChanges: 0, motorWorkJ: 0,
+    maximumWallEffortN: 0, maximumMotorHorizontalForceN: 0, maximumResidualVerticalForceN: 0,
+    groundSeconds: 0, wallSeconds: 0, airSeconds: 0, heldVerified: true }));
+  const samples: unknown[] = [];
+  const events: SimulationSnapshot['events'] = [];
+  const inputDigest = createHash('sha256');
+  let inputs = spec.n ? Array.from({ length: spec.n }, () => ({ ...REST })) : [], priorInputs = inputs;
+  let snapshot = sim.snapshot(), maximumTensionN = 0, minCasualtyY = snapshot.players[spec.casualty].position.y;
+  let firstCatchTick: number | null = null, ending = 'censored', error: string | null = null;
+  let nextDecision = 0, nextSample = 0, lastEventId = -1, reconstructedWorkJ = 0;
+  try {
+    for (let tick = 0; tick < TUNING.physicsHz * profile.horizonSeconds; tick++) {
+      const before = snapshot;
+      if (tick >= nextDecision) { inputs = recutInputs(spec, snapshot); nextDecision += profile.decisionSeconds * TUNING.physicsHz; }
+      inputDigest.update(JSON.stringify(inputs)); inputDigest.update('\n');
+      const motors = before.players.map((p, id) => motorAt(p.position, p.velocity, inputs[id], solids, fixture));
+      sim.step(inputs);
+      snapshot = sim.snapshot();
+      if (snapshot.players.some(p => ![...Object.values(p.position), ...Object.values(p.velocity)].every(Number.isFinite))) throw new Error('Nonfinite body state.');
+      for (const event of snapshot.events) if (event.id > lastEventId) {
+        events.push(event); lastEventId = event.id;
+        if (event.kind === 'catch' && event.playerIds.includes(spec.casualty) && firstCatchTick === null) firstCatchTick = event.tick;
+      }
+      for (const player of snapshot.players) {
+        const id = player.id, role = roles[id], input = inputs[id], motor = motors[id];
+        role.distanceM += distance(before.players[id].position, player.position);
+        if (snapshot.rope.spans.some(span => (span.a === id || span.b === id) && span.tensionN > TUNING.body.mass * TUNING.gravity * TUNING.phase2.wallRopeSupportFraction)) role.loadedSeconds += dt;
+        if (input.brace !== priorInputs[id].brace || Math.hypot(input.x - priorInputs[id].x, input.z - priorInputs[id].z) > TUNING.phase2.inputChangeEpsilon) role.inputChanges++;
+        role.motorWorkJ += motor.workJ; reconstructedWorkJ += motor.workJ;
+        role.maximumWallEffortN = Math.max(role.maximumWallEffortN, motor.wallY);
+        role.maximumMotorHorizontalForceN = Math.max(role.maximumMotorHorizontalForceN, Math.hypot(motor.force.x, motor.force.z));
+        const residualY = TUNING.body.mass * (player.velocity.y - before.players[id].velocity.y) / dt + TUNING.body.mass * TUNING.gravity - motor.force.y;
+        role.maximumResidualVerticalForceN = Math.max(role.maximumResidualVerticalForceN, Math.abs(residualY));
+        role[`${motor.contact}Seconds` as 'groundSeconds' | 'wallSeconds' | 'airSeconds'] += dt;
+        if (heldIds(spec).includes(id) && (input.x !== 0 || input.z !== 0 || input.brace !== (spec.policy === 'static-helpers' || !!spec.frozenBrace))) role.heldVerified = false;
+      }
+      priorInputs = inputs.map(p => ({ ...p }));
+      minCasualtyY = Math.min(minCasualtyY, snapshot.players[spec.casualty].position.y);
+      maximumTensionN = Math.max(maximumTensionN, snapshot.rope.tensionN);
+      if (tick >= nextSample) {
+        samples.push({ tick: snapshot.tick, players: snapshot.players.map(p => ({ id: p.id, position: p.position, velocity: p.velocity, support: p.support, rescueState: p.rescueState })),
+          inputs, tensionN: snapshot.rope.tensionN, spans: snapshot.rope.spans.map(span => {
+            const points = snapshot.rope.points.slice(span.startPoint, span.endPoint + 1);
+            const pathM = points.slice(1).reduce((sum, p, id) => sum + distance(p, points[id]), 0);
+            const directionAt = (id: number) => { const atStart = span.a === id;
+              const a = atStart ? points[0] : points.at(-1)!, b = atStart ? points[1] : points.at(-2)!;
+              return (b.y - a.y) / Math.max(Number.EPSILON, distance(a, b)); };
+            return { id: span.id, tensionN: span.tensionN, pathM, pathSlackM: Math.max(0, span.length - pathM),
+              aVerticalDirection: directionAt(span.a), bVerticalDirection: directionAt(span.b) }; }),
+          energy: { kineticJ: snapshot.diagnostics.kineticEnergyJ, potentialJ: snapshot.diagnostics.potentialEnergyJ,
+            motorWorkJ: snapshot.diagnostics.motorWorkJ, energyProjectionCount: snapshot.diagnostics.energyProjectionCount } });
+        nextSample += profile.sampleSeconds * TUNING.physicsHz;
+      }
+      if (snapshot.run.status === 'failed') { ending = 'terminal'; break; }
+      if (snapshot.incidents.length && snapshot.incidents.every(i => i.status === 'recovered')) { ending = 'recovered'; break; }
+    }
+  } catch (cause) { ending = 'error'; error = String(cause); }
+  finally { sim.dispose(); mutable.wallNormalEffortN = savedEffort; }
+  const first = snapshot.incidents[0];
+  const held = heldIds(spec);
+  return { spec, initialPositions: fixture.positions, initialSpanChordsM, envelope: envelope(variant, spec.surface), ending, error,
+    observedSeconds: snapshot.tick / snapshot.tickHz, firstFallSeconds: snapshot.diagnostics.firstFallSeconds,
+    rescueSeconds: first?.recoveredTick === null || !first ? null : (first.recoveredTick - first.fallTick) / snapshot.tickHz,
+    firstCatchSeconds: firstCatchTick === null ? null : firstCatchTick / snapshot.tickHz,
+    minCasualtyY, ascentFromMinimumM: snapshot.players[spec.casualty].position.y - minCasualtyY,
+    gravitationalAscentWorkJ: (snapshot.players[spec.casualty].position.y - minCasualtyY) * TUNING.body.mass * TUNING.gravity,
+    maximumTensionN, heldIds: held, heldPolicyVerified: held.every(id => roles[id].heldVerified),
+    passiveRecoveryCounterexample: ending === 'recovered' && held.length > 0 && held.every(id => roles[id].heldVerified),
+    motorWorkReconstructionErrorJ: reconstructedWorkJ - snapshot.diagnostics.motorWorkJ,
+    roles, incidents: snapshot.incidents, events, counters: snapshot.counters, diagnostics: snapshot.diagnostics,
+    finalPlayers: snapshot.players, samples, acceptedInputsSha256: inputDigest.digest('hex') };
+}
+
+export function screenSpecs(): Spec[] {
+  return profile.variants.flatMap(variant => profile.screenTeams.flatMap(n =>
+    (['pull-away', 'fan-out', 'static-helpers', 'idle-casualty'] as const).map(policy => ({ variant: variant.name,
+      n, casualty: Math.floor(n / 2), bank: 'same' as const, surface: 'snow' as const, policy }))));
+}
+export function matrixSpecs(): Spec[] {
+  const specs: Spec[] = [];
+  const variant = profile.matrixVariant;
+  for (const n of profile.teamSizes) for (const surface of ['snow', 'ice'] as const) {
+    const casualty = Math.floor(n / 2), base = { variant, n, casualty, bank: 'same' as const, surface };
+    for (const policy of ['pull-away', 'fan-out', 'static-helpers', 'idle-casualty'] as const) specs.push({ ...base, policy });
+    for (let frozenId = 0; frozenId < n; frozenId++) if (frozenId !== casualty) for (const frozenBrace of [false, true]) specs.push({ ...base, policy: 'frozen-helper', frozenId, frozenBrace });
+    if (heldIds({ ...base, policy: 'frozen-remote' }).length) for (const frozenBrace of [false, true]) specs.push({ ...base, policy: 'frozen-remote', frozenBrace });
+    for (const casualty of new Set([0, Math.floor(n / 2), n - 1])) for (const bank of ['same', 'split'] as const) {
+      if (bank === 'same' && casualty === Math.floor(n / 2)) continue;
+      for (const policy of ['pull-away', 'static-helpers', 'idle-casualty'] as const) specs.push({ variant, n, casualty, bank, surface, policy });
+    }
+  }
+  return specs;
+}

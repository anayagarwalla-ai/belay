+import { readFileSync, writeFileSync } from 'node:fs';
+import { TUNING } from '../tuning';
+import { matrixSpecs, type runRecut } from './rescue-recut-harness';
+
+type Report = { worker: number; reusedRows: number; tuningSha256: string; rows: ReturnType<typeof runRecut>[] };
+const parts = Array.from({ length: TUNING.rescueRecut.maximumWorkers }, (_, worker) =>
+  JSON.parse(readFileSync(`reports/rescue-recut-matrix-worker-${worker}.json`, 'utf8')) as Report);
+if (new Set(parts.map(p => p.tuningSha256)).size !== 1) throw new Error('Worker configurations differ.');
+const bySpec = new Map(parts.flatMap(p => p.rows).map(r => [JSON.stringify(r.spec), r]));
+const specs = matrixSpecs();
+if (bySpec.size !== specs.length || parts.reduce((n, p) => n + p.rows.length, 0) !== specs.length) throw new Error('Missing/duplicate matrix cases.');
+const rows = specs.map(spec => { const row = bySpec.get(JSON.stringify(spec)); if (!row) throw new Error('Missing exact matrix spec.'); return row; });
+const { worker: _worker, rows: _rows, ...base } = parts[0];
+const report = { ...base, worker: null, generatedAt: new Date().toISOString(), mergedWorkers: parts.length,
+  reusedRows: parts.reduce((n, p) => n + p.reusedRows, 0), rows };
+const json = JSON.stringify(report, null, 2);
+if (Buffer.byteLength(json) > TUNING.rescueRecut.reportMaximumBytes) throw new Error('Merged report exceeds root bound.');
+writeFileSync('reports/rescue-recut-matrix.json', `${json}\n`);
+writeFileSync('reports/rescue-recut-matrix.jsonl', `${rows.map(r => JSON.stringify(r)).join('\n')}\n`);
+console.log(JSON.stringify({ rows: rows.length, reused: report.reusedRows, bytes: Buffer.byteLength(json) }));
diff --git a/scripts/rescue-recut-run.ts b/scripts/rescue-recut-run.ts
